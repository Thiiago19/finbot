# ─── Obrigatório ───────────────────────────────────────────────
TELEGRAM_TOKEN=

# ─── IA ─────────────────────────────────────────────────────────
# Texto e áudio (principal). Chave em https://console.groq.com/keys
GROQ_API_KEY=
# Imagem, PDF e reserva do texto/áudio. Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcionais (valores padrão entre parênteses)
# GROQ_MODEL=openai/gpt-oss-120b          (texto)
# GROQ_STT_MODEL=whisper-large-v3-turbo   (áudio)
# GROQ_REASONING_EFFORT=low               (só para modelos gpt-oss: low|medium|high)
# GEMINI_MODEL=gemini-2.5-flash-lite
# AI_TEXT_PROVIDERS=groq,gemini           (ordem de tentativa para texto)

# ─── Ambiente ───────────────────────────────────────────────────
DATABASE_PATH=./finbot.db
NODE_ENV=development
# APP_TIMEZONE=America/Sao_Paulo
