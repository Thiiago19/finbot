# ─── Obrigatório ───────────────────────────────────────────────
TELEGRAM_TOKEN=

# ─── IA ─────────────────────────────────────────────────────────
# Texto e áudio (principal). Chave em https://console.groq.com/keys
GROQ_API_KEY=
# Imagem, PDF e reserva do texto/áudio. Chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcionais (valores padrão entre parênteses)
# GROQ_MODEL=openai/gpt-oss-120b          (texto)
# GROQ_STT_MODEL=whisper-large-v3-turbo   (áudio)
# GROQ_REASONING_EFFORT=low               (só para modelos gpt-oss: low|medium|high)
# GEMINI_MODEL=gemini-2.5-flash-lite
# AI_TEXT_PROVIDERS=groq,gemini           (ordem de tentativa para texto)

# ─── Ambiente ───────────────────────────────────────────────────
# Banco local (usado quando TURSO_DATABASE_URL está vazio)
DATABASE_PATH=./finbot.db

# Banco persistente no Turso (obrigatório no Render gratuito, que apaga o disco)
# Crie em https://app.turso.tech → database → "Connect" para pegar a URL e o token
# TURSO_DATABASE_URL=libsql://finbot-<usuario>.turso.io
# TURSO_AUTH_TOKEN=
# TURSO_REPLICA_PATH=./finbot-replica.db  (cópia local da réplica)
NODE_ENV=development
# APP_TIMEZONE=America/Sao_Paulo
# KEEPALIVE=off                          (no Render o bot se pinga a cada 10 min para não hibernar)
